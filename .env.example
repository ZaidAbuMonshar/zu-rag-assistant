# Copy this file to .env (same folder as docker-compose.yml) and fill in a
# real value -- `docker compose` reads .env automatically, so
# ZU_RAG_API_KEY=${ZU_RAG_API_KEY} in docker-compose.yml resolves from there.
# .env itself should never be committed (it's a secret), only this example.
ZU_RAG_API_KEY=change-me-to-a-real-key
